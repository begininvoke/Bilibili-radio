{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bilibili Radio",
  "version": "0.1.0",
  "identifier": "com.ourhome.bilibiliradio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build && powershell -ExecutionPolicy Bypass -File ../deploy/build-desktop-backend.ps1",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bilibili Radio",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../src/icon/icon.png"],
    "resources": ["../../py-radio/dist/bilibili-radio-backend.exe"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
