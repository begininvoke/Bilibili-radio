# Temporary HTTP/IP deployment.
# This mode treats every visitor as the local owner. Use only behind a cloud
# security group, server firewall, VPN, or Tailscale ACL that limits access to you.

AUTH_MODE=disabled
ALLOW_INSECURE_LOCAL_AUTH=1
SESSION_COOKIE_SECURE=false
APP_SESSION_COOKIE_NAME=br_session

HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80

APP_SECRET_KEY=replace-with-python-secrets-token-urlsafe-48
APP_SESSION_TTL_SECONDS=604800
APP_SESSION_IDLE_SECONDS=86400
APP_ADMIN_SESSION_TTL_SECONDS=28800
APP_SESSION_MAX_ACTIVE=5

WEB_CONCURRENCY=2
WEB_THREADS=16
GUNICORN_TIMEOUT=120

GRAFANA_ADMIN_PASSWORD=replace-if-you-start-monitoring
METRICS_BEARER_TOKEN=replace-if-you-start-monitoring
