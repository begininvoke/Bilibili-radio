# Use a secret manager in production. This file documents required names only.
METRICS_BEARER_TOKEN=replace-with-at-least-32-random-bytes
GRAFANA_ADMIN_USER=local-admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-bootstrap-password
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3001
GRAFANA_PUBLIC_URL=http://localhost:3001
GRAFANA_COOKIE_SECURE=false
GRAFANA_SERVE_FROM_SUB_PATH=false

# Give Grafana its own OIDC client and exact redirect URI:
# https://your-host.example/login/generic_oauth
GRAFANA_OIDC_ENABLED=false
GRAFANA_OIDC_CLIENT_ID=bilibili-radio-grafana
GRAFANA_OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
GRAFANA_OIDC_SCOPES=openid profile email
GRAFANA_OIDC_AUTH_URL=https://idp.example/authorize
GRAFANA_OIDC_TOKEN_URL=https://idp.example/token
GRAFANA_OIDC_USERINFO_URL=https://idp.example/userinfo

# Permit only the known administrator. Copy the immutable OIDC `sub` value here.
# A provider group can be used instead: contains(groups[*], 'bilibili-radio-admin') && 'GrafanaAdmin'
GRAFANA_OIDC_ROLE_ATTRIBUTE_PATH=sub == 'replace-with-admin-sub' && 'GrafanaAdmin'
GRAFANA_OIDC_ROLE_ATTRIBUTE_STRICT=true
GRAFANA_OIDC_LOGIN_ATTRIBUTE_PATH=preferred_username
GRAFANA_OIDC_EMAIL_ATTRIBUTE_PATH=email

# Keep the local bootstrap login until OIDC has been verified end to end.
GRAFANA_DISABLE_LOGIN_FORM=false

PROMETHEUS_RETENTION_TIME=90d
PROMETHEUS_RETENTION_SIZE=2GB
ALERTMANAGER_RETENTION_TIME=120h
